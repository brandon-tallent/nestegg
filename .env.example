# Copy to .env and fill in. docker compose reads it automatically.

# Password for the local Postgres. Letters and digits only: it is placed in a
# connection URL. Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Your Monarch Money login
MONARCH_EMAIL=
MONARCH_PASSWORD=

# Hours between syncs
#SYNC_INTERVAL_HOURS=4

# Host port Postgres listens on (localhost only)
#POSTGRES_PORT=5432

# Host port the MCP server listens on (localhost only), and the Host names
# clients may reach it by. Add your own when proxying it, e.g. over Tailscale.
#MCP_PORT=8091
#MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# "true" refiles card statement credits in Monarch itself so each nets out
# against the purchase it refunds. This edits your Monarch data.
#RECONCILE_CREDITS=false

# Push a notification after each sync. The message includes your net worth and
# ntfy.sh topics are readable by anyone who knows the name, so use a
# self-hosted server or an unguessable topic.
#NTFY_URL=

# Carta login, only for: docker compose run --rm sync carta
#CARTA_EMAIL=
#CARTA_PASSWORD=
# Verification method to switch to instead of Carta's default text message
#CARTA_MFA_METHOD=

# Use a locally built image instead of the published one
#NESTEGG_IMAGE=nestegg:local
